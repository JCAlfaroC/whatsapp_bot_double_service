# --- Gateway de WhatsApp (Evolution API) ---------------------------------
# Es uno solo: los dos servicios comparten el mismo número.
EVOLUTION_API_URL=https://EVOLUTION_HOST
EVOLUTION_API_KEY=your_key_here
EVOLUTION_INSTANCE_NAME=NOMBRE_DE_LA_INSTANCIA

# Listas y botones interactivos. Con 0 el bot manda los menus numerados en
# texto y no intenta el mensaje interactivo.
# Ponerlo en 0 si /message/sendList devuelve 400 con
# "TypeError: this.isZero is not a function": esa instalacion de Evolution no
# los soporta, y cada menu gasta una peticion fallida y el doble de espera
# para terminar mandando el texto igual.
EVOLUTION_INTERACTIVE=1

# --- LOLCLI ---------------------------------------------------------------
# Sólo hacen falta si NO se usa clinics.json (despliegue de un solo cliente).
# Con clinics.json presente, cada clínica trae los suyos y estos valores
# quedan como respaldo para las claves que ese archivo no defina.
LOLCLI_API_URL=http://HOST:PUERTO/LolcliApi/api
LOLCLI_API_TOKEN=your_basic_token_here
LOLCLI_ENTIDAD=CODIGO_DE_ENTIDAD

# Los dos flujos pueden vivir en servidores o puertos distintos de LOLCLI. Si
# se dejan vacíos, ambos usan LOLCLI_API_URL.
LOLCLI_API_URL_PACIENTES=
LOLCLI_API_URL_QUIROFANOS=

# Clínica que atiende /webhook (sin clinic_id en la URL). Si se deja vacío se
# usa la primera de clinics.json.
DEFAULT_CLINIC_ID=

# --- Datos de la clínica (respaldo si no hay clinics.json) ---------------
DEFAULT_SISCOD=1
STAFF_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=Lunes a Viernes, 8am - 6pm

# --- Pagos de citas (pacientes) ------------------------------------------
# FASE DE PRUEBAS: prefijo que se antepone al host del enlace de pago que
# devuelve LOLCLI, para que el cobro caiga en el entorno de pruebas de Niubiz.
# Dejar VACÍO al pasar a producción real.
PAGOS_QA_PREFIX=qa-pacientes.

# --- Pagos de quirófanos (médicos) ---------------------------------------
# 1 = cobrar antes de grabar la reserva. Se deja en 0 hasta que LOLIMSA envíe
# las URLs y credenciales; con 0 el bot confirma y graba la reserva sin cobrar.
PAGOS_HABILITADOS=0
PAGOS_URL_BASE=

# --- Servidor -------------------------------------------------------------
PORT=5000
WAITRESS_THREADS=50
LOLCLI_TIMEOUT=15
EVOLUTION_TIMEOUT=15
# Pausa (segundos) antes de cada mensaje saliente, para que no lleguen
# desordenados ni parezcan envío masivo.
SEND_PACING_SECONDS=1.2
